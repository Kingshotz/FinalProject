<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="TBC UI Regression" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="ge.tbc.testautomation.util.RetryTransformer"/>
    </listeners>

    <test name="Desktop">
        <parameter name="platform" value="desktop"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.FilterLocationsTest"/>
            <class name="ge.tbc.testautomation.tests.LocationsSearchTest"/>
            <class name="ge.tbc.testautomation.tests.MortgageCalculatorTest"/>
            <class name="ge.tbc.testautomation.tests.MortgageCalculatorInvalidInputTest"/>
            <class name="ge.tbc.testautomation.tests.AppDownloadBannerTest"/>
        </classes>
    </test>

    <test name="Mobile">
        <parameter name="platform" value="mobile"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.FilterLocationsTest"/>
            <class name="ge.tbc.testautomation.tests.LocationsSearchTest"/>
            <class name="ge.tbc.testautomation.tests.MortgageCalculatorTest"/>
            <class name="ge.tbc.testautomation.tests.MortgageCalculatorInvalidInputTest"/>
            <class name="ge.tbc.testautomation.tests.AppDownloadBannerTest"/>
        </classes>
    </test>

</suite>